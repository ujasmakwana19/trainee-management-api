services:
  db:
    image: mysql:8.0.46
    container_name: docker1db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: Ram@19
      MYSQL_DATABASE: trainee_management_db
    ports:
      - "3308:3306"
    volumes:
      - mysql_docker_data:/var/lib/mysql

  redis-cache:
    image: redis:7.0.11-alpine  # Switched to the Alpine version
    container_name: docker1redis
    restart: always
    ports:
      - "6379:6379"

  rabbitmq:
    image: rabbitmq:3.12.0-management-alpine
    container_name: docker1rabbitmq
    restart: always
    ports:
      - "5672:5672"
      - "15672:15672"
    
    environment:
      RABBITMQ_DEFAULT_USER: admin
      RABBITMQ_DEFAULT_PASS: Ram@19
      RABBITMQ_DEFAULT_VHOST: mqhost
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
 
volumes:
  mysql_docker_data:
  rabbitmq_data:
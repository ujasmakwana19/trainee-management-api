services:
  db:
    image: mysql:8.0
    container_name: <container_name>
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: <root_password>
      MYSQL_DATABASE: <database_name>
    ports:
      - "<host_port>:3306"
    volumes:
      - <folder_name>:/var/lib/mysql
  
  redis-cache:mysql:8.0
    container_name: dotnetrediscache
    restart: always
    ports:
      - "6379:6379"
  
  rabbitmq:
    image: rabbitmq:3:management
    container_name: docker1rabbitmq
    restart: always
    ports:
      - "5672:5672"
      - "15672:15672"
    
    environment:
      RABBITMQ_DEFAULT_USER: 
      RABBITMQ_DEFAULT_PASS: 
      RABBITMQ_DEFAULT_VHOST: 
    volumes:
      - 
volumes:
  <folder_name>: